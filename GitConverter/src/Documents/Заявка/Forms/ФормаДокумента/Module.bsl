&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Если создаем новую заявку, устанавливаем значения по умолчанию
	Если Объект.Ссылка.Пустая() Тогда
		Объект.Дата = ТекущаяДата();
		Объект.Статус = Перечисления.СтатусыЗаявок.Открыта;
	КонецЕсли;
	
	// Управление видимостью группы периода
	УправлениеВидимостьюПолейПериода();
	
КонецПроцедуры

&НаКлиенте
Процедура ТипЗаявкиПриИзменении(Элемент)
	
	УправлениеВидимостьюПолейПериода();
	
КонецПроцедуры

&НаСервере
Процедура УправлениеВидимостьюПолейПериода()
	
	// Проверяем, требует ли выбранный тип заявки указания периода
	ТребуетПериод = Ложь;
	
	Если ЗначениеЗаполнено(Объект.ТипЗаявки) Тогда
		ТребуетПериод = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.ТипЗаявки, "ТребуетПериод");
	КонецЕсли;
	
	// Управляем видимостью полей периода
	Элементы.ГруппаПериод.Видимость = ТребуетПериод;
	
	// Если период не требуется, очищаем поля
	Если НЕ ТребуетПериод Тогда
		Объект.ДатаНачала = '00010101';
		Объект.ДатаОкончания = '00010101';
	КонецЕсли;
	
КонецПроцедуры

