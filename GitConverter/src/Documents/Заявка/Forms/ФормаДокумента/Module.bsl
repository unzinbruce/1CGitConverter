Процедура ФизическоеЛицоПриИзменении(Элемент)
	
	// Дополнительные действия при выборе физического лица можно добавить здесь
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправитьЗапрос(Команда)
	
	// Проверяем заполнение обязательных полей
	Если НЕ ПроверитьЗаполнениеОбязательныхПолей() Тогда
		Возврат;
	КонецЕсли;
	
	// Проверяем корректность периода
	Если НЕ ПроверитьКорректностьПериода() Тогда
		Возврат;
	КонецЕсли;
	
	// Записываем документ
	Если ЗаписатьДокумент() Тогда
		ПоказатьПредупреждение(, "Заявка успешно отправлена!");
		Закрыть();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ПроверитьЗаполнениеОбязательныхПолей()
	
	Если НЕ ЗначениеЗаполнено(Объект.ФизическоеЛицо) Тогда
		ПоказатьПредупреждение(, "Необходимо выбрать физическое лицо!");
		Возврат Ложь;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.ТипЗаявки) Тогда
		ПоказатьПредупреждение(, "Необходимо выбрать тип заявки!");
		Возврат Ложь;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.Причина) Тогда
		ПоказатьПредупреждение(, "Необходимо указать причину!");
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

&НаКлиенте
Функция ПроверитьКорректностьПериода()
	
	// Если группа периода видима, проверяем заполнение дат
	Если Элементы.ГруппаПериод.Видимость Тогда
		
		Если НЕ ЗначениеЗаполнено(Объект.ДатаНачала) Тогда
			ПоказатьПредупреждение(, "Необходимо указать дату начала!");
			Возврат Ложь;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Объект.ДатаОкончания) Тогда
			ПоказатьПредупреждение(, "Необходимо указать дату окончания!");
			Возврат Ложь;
		КонецЕсли;
		
		Если Объект.ДатаНачала > Объект.ДатаОкончания Тогда
			ПоказатьПредупреждение(, "Дата начала не может быть больше даты окончания!");
			Возврат Ложь;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

&НаСервере
Функция ЗаписатьДокумент()
	
	Попытка
		Объект.Записать();
		Возврат Истина;
	Исключение
		ПоказатьПредупреждение(, "Ошибка при записи документа: " + ОписаниеОшибки());
		Возврат Ложь;
	КонецПопытки;
	
КонецФункции