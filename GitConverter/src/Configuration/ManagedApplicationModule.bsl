#Область ОписаниеПеременных

// СтандартныеПодсистемы

// Хранилище глобальных переменных.
//
// ПараметрыПриложения - Соответствие - хранилище переменных, где:
//   * Ключ - Строка - имя переменной в формате "ИмяБиблиотеки.ИмяПеременной";
//   * Значение - Произвольный - значение переменной.
//
// Инициализация (на примере СообщенияДляЖурналаРегистрации):
//   ИмяПараметра = "СтандартныеПодсистемы.СообщенияДляЖурналаРегистрации";
//   Если ПараметрыПриложения[ИмяПараметра] = Неопределено Тогда
//     ПараметрыПриложения.Вставить(ИмяПараметра, Новый СписокЗначений);
//   КонецЕсли;
//  
// Использование (на примере СообщенияДляЖурналаРегистрации):
//   ПараметрыПриложения["СтандартныеПодсистемы.СообщенияДляЖурналаРегистрации"].Добавить(...);
//   ПараметрыПриложения["СтандартныеПодсистемы.СообщенияДляЖурналаРегистрации"] = ...;
Перем ПараметрыПриложения Экспорт;

// Конец СтандартныеПодсистемы

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ПередНачаломРаботыСистемы(Отказ)
	
	Если ПараметрыПриложения = Неопределено Тогда
		ПараметрыПриложения = Новый Соответствие;
	КонецЕсли;

КонецПроцедуры

Процедура ПриНачалеРаботыСистемы()
	
	// Инициализация предопределенных типов заявок при первом запуске
	УправлениеЗаявками.ИнициализироватьПредопределенныеТипыЗаявок();
	
	// Проверяем, может ли текущий пользователь подавать заявки
	Если УправлениеЗаявками.ТекущийПользовательМожетПодаватьЗаявки() Тогда
		// Показываем предложение подать заявку
		ТекстВопроса = "Вы можете подать заявку на отгул, отпуск, больничный или жалобу/пожелание. Хотите открыть форму подачи заявки?";
		
		ОписаниеОповещения = Новый ОписаниеОповещения("ОбработатьОтветНаВопросОПодачеЗаявки", ЭтотОбъект);
		ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	КонецЕсли;
	
	// Проверяем наличие новых заявок для администраторов
	Если УправлениеЗаявками.ТекущийПользовательМожетОбрабатыватьЗаявки() Тогда
		КоличествоНовыхЗаявок = УправлениеЗаявками.ПолучитьКоличествоНовыхЗаявок();
		
		Если КоличествоНовыхЗаявок > 0 Тогда
			ТекстУведомления = СтрШаблон("У вас %1 новых заявок для обработки. Хотите открыть обработку заявок?", КоличествоНовыхЗаявок);
			
			ОписаниеОповещения = Новый ОписаниеОповещения("ОбработатьОтветНаВопросОбОбработкеЗаявок", ЭтотОбъект);
			ПоказатьВопрос(ОписаниеОповещения, ТекстУведомления, РежимДиалогаВопрос.ДаНет);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработатьОтветНаВопросОПодачеЗаявки(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		УправлениеЗаявками.ОткрытьФормуПодачиЗаявки();
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработатьОтветНаВопросОбОбработкеЗаявок(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		ОткрытьФорму("Обработка.ОбработкаЗаявок.Форма.Форма");
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти
