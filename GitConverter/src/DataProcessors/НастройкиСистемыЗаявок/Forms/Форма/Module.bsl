&НаКлиенте
Процедура Сохранить(Команда)
	
	Если СохранитьНастройкиНаСервере() Тогда
		ПоказатьПредупреждение(, "Настройки успешно сохранены!");
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция СохранитьНастройкиНаСервере()
	
	Попытка
		
		НачатьТранзакцию();
		
		// Очищаем старые настройки
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	НастройкиЗаявок.НастройкаПараметр КАК НастройкаПараметр
		|ИЗ
		|	РегистрСведений.НастройкиЗаявок КАК НастройкиЗаявок
		|ГДЕ
		|	НастройкиЗаявок.НастройкаПараметр В (&СписокПараметров)";
		
		СписокПараметров = Новый Массив;
		СписокПараметров.Добавить("ПользователиДляЗапросов");
		СписокПараметров.Добавить("ПолучателиЗапросов");
		
		Запрос.УстановитьПараметр("СписокПараметров", СписокПараметров);
		
		Результат = Запрос.Выполнить();
		Выборка = Результат.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			НаборЗаписей = РегистрыСведений.НастройкиЗаявок.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.НастройкаПараметр.Установить(Выборка.НастройкаПараметр);
			НаборЗаписей.Записать();
		КонецЦикла;
		
		// Сохраняем пользователей для запросов
		Если ПользователиДляЗапросов.Количество() > 0 Тогда
			НаборЗаписей = РегистрыСведений.НастройкиЗаявок.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.НастройкаПараметр.Установить("ПользователиДляЗапросов");
			
			Запись = НаборЗаписей.Добавить();
			Запись.НастройкаПараметр = "ПользователиДляЗапросов";
			Запись.ЗначениеСписок = ОбщегоНазначения.ЗначениеВСтрокуXML(ПользователиДляЗапросов.ВыгрузитьЗначения());
			
			НаборЗаписей.Записать();
		КонецЕсли;
		
		// Сохраняем получателей запросов
		Если ПолучателиЗапросов.Количество() > 0 Тогда
			НаборЗаписей = РегистрыСведений.НастройкиЗаявок.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.НастройкаПараметр.Установить("ПолучателиЗапросов");
			
			Запись = НаборЗаписей.Добавить();
			Запись.НастройкаПараметр = "ПолучателиЗапросов";
			Запись.ЗначениеСписок = ОбщегоНазначения.ЗначениеВСтрокуXML(ПолучателиЗапросов.ВыгрузитьЗначения());
			
			НаборЗаписей.Записать();
		КонецЕсли;
		
		// Сохраняем настройки типов запросов
		Для Каждого СтрокаТипа Из ТипыЗапросов Цикл
			Если ЗначениеЗаполнено(СтрокаТипа.ТипЗаявки) Тогда
				ОбъектТипа = СтрокаТипа.ТипЗаявки.ПолучитьОбъект();
				ОбъектТипа.ТребуетПериод = СтрокаТипа.ТребуетПериод;
				ОбъектТипа.Записать();
			КонецЕсли;
		КонецЦикла;
		
		ЗафиксироватьТранзакцию();
		
		Возврат Истина;
		
	Исключение
		ОтменитьТранзакцию();
		ПоказатьПредупреждение(, "Ошибка при сохранении настроек: " + ОписаниеОшибки());
		Возврат Ложь;
	КонецПопытки;
	
КонецФункции