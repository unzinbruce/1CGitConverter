&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Загружаем настройки из регистра
	ЗагрузитьНастройки();
	
	// Инициализируем таблицу типов запросов
	ИнициализироватьТаблицуТиповЗапросов();
	
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьНастройки()
	
	// Загружаем пользователей для запросов
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	НастройкиЗаявок.ЗначениеСписок
	|ИЗ
	|	РегистрСведений.НастройкиЗаявок КАК НастройкиЗаявок
	|ГДЕ
	|	НастройкиЗаявок.НастройкаПараметр = &Параметр";
	
	Запрос.УстановитьПараметр("Параметр", "ПользователиДляЗапросов");
	Результат = Запрос.Выполнить();
	
	Если НЕ Результат.Пустой() Тогда
		Выборка = Результат.Выбрать();
		Если Выборка.Следующий() И ЗначениеЗаполнено(Выборка.ЗначениеСписок) Тогда
			ПользователиДляЗапросов.ЗагрузитьЗначения(ОбщегоНазначения.ЗначениеИзСтрокиXML(Выборка.ЗначениеСписок));
		КонецЕсли;
	КонецЕсли;
	
	// Загружаем получателей запросов
	Запрос.УстановитьПараметр("Параметр", "ПолучателиЗапросов");
	Результат = Запрос.Выполнить();
	
	Если НЕ Результат.Пустой() Тогда
		Выборка = Результат.Выбрать();
		Если Выборка.Следующий() И ЗначениеЗаполнено(Выборка.ЗначениеСписок) Тогда
			ПолучателиЗапросов.ЗагрузитьЗначения(ОбщегоНазначения.ЗначениеИзСтрокиXML(Выборка.ЗначениеСписок));
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ИнициализироватьТаблицуТиповЗапросов()
	
	// Создаем колонки таблицы типов запросов
	ТипыЗапросов.Колонки.Добавить("ТипЗаявки", Новый ОписаниеТипов("СправочникСсылка.ТипыЗаявок"), "Тип заявки");
	ТипыЗапросов.Колонки.Добавить("ТребуетПериод", Новый ОписаниеТипов("Булево"), "Требует период");
	
	// Загружаем существующие типы заявок
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТипыЗаявок.Ссылка КАК ТипЗаявки,
	|	ТипыЗаявок.ТребуетПериод КАК ТребуетПериод
	|ИЗ
	|	Справочник.ТипыЗаявок КАК ТипыЗаявок
	|ГДЕ
	|	НЕ ТипыЗаявок.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	ТипыЗаявок.Наименование";
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = ТипыЗапросов.Добавить();
		НоваяСтрока.ТипЗаявки = Выборка.ТипЗаявки;
		НоваяСтрока.ТребуетПериод = Выборка.ТребуетПериод;
	КонецЦикла;
	
КонецПроцедуры

