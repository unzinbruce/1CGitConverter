// Модуль для работы с системой заявок

// Проверяет, является ли текущий пользователь пользователем для подачи запросов
//
// Возвращаемое значение:
//   Булево - Истина, если пользователь может подавать заявки
//
Функция ТекущийПользовательМожетПодаватьЗаявки() Экспорт
	
	// Получаем настройки пользователей для запросов
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	НастройкиЗаявок.ЗначениеСписок
	|ИЗ
	|	РегистрСведений.НастройкиЗаявок КАК НастройкиЗаявок
	|ГДЕ
	|	НастройкиЗаявок.НастройкаПараметр = &Параметр";
	
	Запрос.УстановитьПараметр("Параметр", "ПользователиДляЗапросов");
	Результат = Запрос.Выполнить();
	
	Если Результат.Пустой() Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Выборка = Результат.Выбрать();
	Если Выборка.Следующий() И ЗначениеЗаполнено(Выборка.ЗначениеСписок) Тогда
		
		СписокПользователей = ОбщегоНазначения.ЗначениеИзСтрокиXML(Выборка.ЗначениеСписок);
		ТекущийПользователь = ПользователиИнформационнойБазы.ТекущийПользователь();
		
		Для Каждого ЭлементСписка Из СписокПользователей Цикл
			Если ЭлементСписка.Значение = ТекущийПользователь Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

// Проверяет, является ли текущий пользователь администратором системы заявок
//
// Возвращаемое значение:
//   Булево - Истина, если пользователь может обрабатывать заявки
//
Функция ТекущийПользовательМожетОбрабатыватьЗаявки() Экспорт
	
	// Получаем настройки получателей запросов
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	НастройкиЗаявок.ЗначениеСписок
	|ИЗ
	|	РегистрСведений.НастройкиЗаявок КАК НастройкиЗаявок
	|ГДЕ
	|	НастройкиЗаявок.НастройкаПараметр = &Параметр";
	
	Запрос.УстановитьПараметр("Параметр", "ПолучателиЗапросов");
	Результат = Запрос.Выполнить();
	
	Если Результат.Пустой() Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Выборка = Результат.Выбрать();
	Если Выборка.Следующий() И ЗначениеЗаполнено(Выборка.ЗначениеСписок) Тогда
		
		СписокПользователей = ОбщегоНазначения.ЗначениеИзСтрокиXML(Выборка.ЗначениеСписок);
		ТекущийПользователь = ПользователиИнформационнойБазы.ТекущийПользователь();
		
		Для Каждого ЭлементСписка Из СписокПользователей Цикл
			Если ЭлементСписка.Значение = ТекущийПользователь Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

// Открывает форму подачи заявки для текущего пользователя
//
Процедура ОткрытьФормуПодачиЗаявки() Экспорт
	
	Если ТекущийПользовательМожетПодаватьЗаявки() Тогда
		ОткрытьФорму("Документ.Заявка.ФормаОбъекта");
	Иначе
		ПоказатьПредупреждение(, "У вас нет прав на подачу заявок!");
	КонецЕсли;
	
КонецПроцедуры

// Возвращает количество новых заявок для текущего администратора
//
// Возвращаемое значение:
//   Число - Количество открытых заявок
//
Функция ПолучитьКоличествоНовыхЗаявок() Экспорт
	
	Если НЕ ТекущийПользовательМожетОбрабатыватьЗаявки() Тогда
		Возврат 0;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(*) КАК Количество
	|ИЗ
	|	Документ.Заявка КАК Заявка
	|ГДЕ
	|	НЕ Заявка.ПометкаУдаления
	|	И Заявка.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыЗаявок.Открыта)";
	
	Результат = Запрос.Выполнить();
	Если НЕ Результат.Пустой() Тогда
		Выборка = Результат.Выбрать();
		Если Выборка.Следующий() Тогда
			Возврат Выборка.Количество;
		КонецЕсли;
	КонецЕсли;
	
	Возврат 0;
	
КонецФункции

// Инициализирует предопределенные типы заявок при первом запуске
//
Процедура ИнициализироватьПредопределенныеТипыЗаявок() Экспорт
	
	// Проверяем, есть ли уже типы заявок
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(*) КАК Количество
	|ИЗ
	|	Справочник.ТипыЗаявок КАК ТипыЗаявок
	|ГДЕ
	|	НЕ ТипыЗаявок.ПометкаУдаления";
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Если Выборка.Следующий() И Выборка.Количество = 0 Тогда
		
		// Создаем предопределенные типы заявок
		ПредопределенныеТипы = Новый Массив;
		ПредопределенныеТипы.Добавить(Новый Структура("Наименование, ТребуетПериод", "Отгул", Истина));
		ПредопределенныеТипы.Добавить(Новый Структура("Наименование, ТребуетПериод", "Отпуск", Истина));
		ПредопределенныеТипы.Добавить(Новый Структура("Наименование, ТребуетПериод", "Больничный", Истина));
		ПредопределенныеТипы.Добавить(Новый Структура("Наименование, ТребуетПериод", "Жалобы и пожелания", Ложь));
		
		Для Каждого ТипЗаявки Из ПредопределенныеТипы Цикл
			НовыйТип = Справочники.ТипыЗаявок.СоздатьЭлемент();
			НовыйТип.Наименование = ТипЗаявки.Наименование;
			НовыйТип.ТребуетПериод = ТипЗаявки.ТребуетПериод;
			
			Попытка
				НовыйТип.Записать();
			Исключение
				// Игнорируем ошибки при создании предопределенных типов
			КонецПопытки;
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры